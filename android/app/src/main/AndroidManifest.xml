<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Omarchy Launcher — Permisos de almacenamiento.

      Estrategia (gestión segura):
        - Android <= 9 (API <= 28):  READ/WRITE_EXTERNAL_STORAGE clásicos.
        - Android 10 (API 29):       WRITE deprecada pero aún válida con
                                     requestLegacyExternalStorage="true".
        - Android >= 11 (API >= 30): scoped storage; el acceso amplio a
                                     /sdcard/OmarchyLauncher se concede con
                                     MANAGE_EXTERNAL_STORAGE (All Files Access).
      Si ninguno se concede, la app degrada automáticamente a su carpeta
      externa privada (sin permisos) y lo indica en pantalla.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>

    <!-- Acceso de red: registro del marketplace de plugins (omarchyplugins.com). -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Permite enviar comandos a Termux vía el intent com.termux.RUN_COMMAND
         (requiere Termux:API instalado). Sin este permiso el broadcast se descarta. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND"/>

    <!-- Permite restaurar la navegación por gestos cuando Xiaomi/HyperOS la desactiva
         tras cambiar el launcher por defecto. Requiere concesión manual vía ADB. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>

    <!-- Permite al servicio de accesibilidad dibujar una capa transparente para capturar gestos. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <application
        android:label="Ohm Launcher"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustPan">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <!-- 1) Launcher por defecto: candidato a HOME (categoría HOME). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>

            <!-- 2) Accesible desde el cajón de aplicaciones. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Servicio de accesibilidad que captura gestos de navegación globales
             cuando MIUI/HyperOS no los proporciona para launchers de terceros. -->
        <service
            android:name=".OhmGestureAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Visibilidad de apps lanzables (Android 11+ package visibility):
             permite listar y abrir las apps reales instaladas. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
